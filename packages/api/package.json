    "fastify": "^5.12.5",
    "nodemailer": "^10.1.4",
    "openid-client": "^5.6.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
