# Copy to .env and fill in. NEVER commit .env.

# --- Images (optional: pull released images instead of building) ---
# Set to e.g. forge.example.org/yourorg/trip-api:v1.2.3 to use CI-built images.
# IMAGE_API=trip-api:local
# IMAGE_WEB=trip-web:local

# --- Edge / Traefik (separate VPS) ---
# Public hostname your Traefik edge serves (used in traefik/dynamic.yml).
APP_HOST=challenges.example.org
# Private bind address on THIS host that the edge reaches over WireGuard/VPN.
# Must NOT be 0.0.0.0 — these ports are not for the public internet.
APP_BIND_ADDR=10.0.0.2

# --- API ---
API_PORT=3000
NODE_ENV=development
# Public base URL the QR codes point at (challenge URLs) — must match APP_HOST.
PUBLIC_BASE_URL=https://challenges.example.org

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trip
POSTGRES_USER=trip
POSTGRES_PASSWORD=change-me-strong

# --- Object storage (S3 API: MinIO, AWS S3, Cloudflare R2, Backblaze B2, …) ---
# The API talks the S3 protocol. Pick ONE provider below.
#
# (a) Bundled MinIO (default; the `minio` service in docker-compose.yml):
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=trip-minio
S3_SECRET_ACCESS_KEY=change-me-strong
S3_BUCKET=submissions
S3_FORCE_PATH_STYLE=true
#
# (b) AWS S3 — omit S3_ENDPOINT, set the region, use virtual-hosted style:
#   # S3_ENDPOINT unset
#   S3_REGION=eu-west-1
#   S3_ACCESS_KEY_ID=AKIA...
#   S3_SECRET_ACCESS_KEY=...
#   S3_BUCKET=trip-challenges-prod
#   S3_FORCE_PATH_STYLE=false
#
# (c) Cloudflare R2:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=<R2 access key id>
#   S3_SECRET_ACCESS_KEY=<R2 secret>
#   S3_BUCKET=trip-challenges
#   S3_FORCE_PATH_STYLE=false
#
# Bundled-MinIO server credentials — ONLY used by the `minio` service in
# docker-compose.yml. Match S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY above.
# Delete this pair when you point S3_* at an external provider (AWS/R2/B2).
MINIO_ROOT_USER=trip-minio
MINIO_ROOT_PASSWORD=change-me-strong

# --- Vault (per-Trip crypto keys; transit engine) ---
VAULT_ADDR=http://vault:8200
# Dev root token only for local; use AppRole/policies in prod.
VAULT_TOKEN=dev-root-token
VAULT_TRANSIT_MOUNT=transit

# --- PocketID OIDC (teacher auth) ---
OIDC_ISSUER=https://pocketid.example.org
OIDC_CLIENT_ID=trip-challenges
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://localhost/api/auth/teacher/callback

# --- Sessions / tokens ---
# Secret for signing student device tokens + teacher session cookies.
SESSION_SECRET=change-me-64-random-bytes

# --- Client IPs and rate limits (requests/minute) ---
# Peers allowed to set X-Forwarded-For (the edge proxy). The API is only reachable through
# it on the internal network, so private ranges by default. Without this, every client
# looks like the proxy and the whole school shares one rate-limit bucket.
# TRUST_PROXY=loopback,linklocal,uniquelocal
# Per client IP, all routes (a voting phone makes ~4 requests per duel):
# RATE_LIMIT_MAX=600
# Per ACCESS CODE on redeem (brute-force guard; a class shares one school Wi-Fi IP):
# RATE_LIMIT_AUTH_MAX=5
# Per client IP on "email me a new code" (sends mail):
# RATE_LIMIT_REISSUE_MAX=20

# --- Email (Access Code + erasure warnings) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Trip Challenges <no-reply@example.org>"

# --- Operations alerts ---
# Also receives "erasure failed" alerts (each Trip's teachers always do).
# ALERT_EMAIL=ops@example.org
# Dead-man's switch: pinged after every healthy scheduler tick (erasures all succeeded).
# Point it at a monitor such as healthchecks.io with a ~5 min grace; silence = alert.
# HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# --- Antivirus (ClamAV) ---
# When true, uploaded photos are scanned by clamd before storage and the upload
# is refused if clamd is unreachable (fail-closed). The compose stack provides
# a `clamav` service; leave false only for local dev without it.
AV_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
